# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TURSO Database: LibSQL connection URL and Auth Token.
# Configure your Turso credentials (e.g. from https://app.turso.tech/smpsandro1239).
# If not provided, the server automatically uses local persistent SQLite with fallback.
TURSO_DATABASE_URL="libsql://your-db-smpsandro1239.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Backend/Worker e frontend (migração Cloudflare) ---
# Segredo de sessão do backend (gerar: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""

# Origens autorizadas (CORS e proteção CSRF), separadas por vírgula, sem espaços.
ALLOWED_ORIGINS="http://localhost:3000,https://maisjuntos-five.vercel.app"

# Frontend: Vazio = pedidos relativos /api/* (Vercel faz rewrite para o Worker).
# Definir apenas se o frontend for chamar o Worker diretamente.
VITE_API_URL=""

# Semente de demonstração do frontend (favoritos pré-populados). DESLIGADA por
# omissão: um visitante novo arranca sempre como «Família Visitante» (convidado),
# nunca autenticado nem com dados de uma pessoa fictícia. Definir a "1" apenas em
# ambientes de demonstração.
VITE_DEMO_SEED="0"

# Frontend: URL do WebSocket. O Vercel não faz proxy de WS, por isso aponta
# diretamente ao Worker. O endpoint do Worker é /ws (obrigatório incluí-lo).
VITE_WS_URL="wss://juntos-backend.smpsandro1239.workers.dev/ws"

# Credenciais das contas de sistema — usadas apenas no seed inicial
# (tabela `users` vazia). NUNCA versionar valores reais.
# O seed usa valores de desenvolvimento se estas variáveis não existirem.
ADMIN_PASSWORD=""
CURATOR_PASSWORD=""
PARENT_PASSWORD=""

# --- Email transacional (verificação de conta e reposição de palavra-passe) ---
# Se RESEND_API_KEY estiver definida, os emails são enviados pela API do Resend.
# Sem ela, o conteúdo é apenas registado no console (modo desenvolvimento).
# Obter em https://resend.com/api-keys
RESEND_API_KEY=""
# Remetente dos emails (o domínio tem de estar verificado no fornecedor).
EMAIL_FROM="+JUNTOS <noreply@maisjuntos.pt>"

# Hook de limpeza de dados de teste (APENAS desenvolvimento local). Enquanto
# `NODE_ENV=production`, o endpoint devolve sempre 404, mesmo com esta flag a
# `true`. Ativa-o no `.env` local para que `npm run test:auth` limpe as contas
# efémeras que cria.
ALLOW_TEST_HOOKS=false

# Política de verificação de email (revisão F5.7, BLOCO 4). Por omissão é
# SUAVE: o login é permitido e o banner incentiva a confirmação. Definir a
# `true` passa a EXIGIR email confirmado para iniciar sessão (o pedido de login
# devolve 403 com `code: EMAIL_NOT_VERIFIED`). Recomenda-se manter a `false`
# até o envio de emails (Resend) estar operacional em produção.
REQUIRE_EMAIL_VERIFICATION=false

# Login social (F5.5 — Google/GitHub). Sem chaves, /api/auth/oauth/:provider/start
# devolve 503 (OAUTH_NOT_CONFIGURED) e o frontend mostra um aviso em vez de
# navegar. Registe o redirect URI no provider:
#   <backend>/api/auth/oauth/google/callback
#   <backend>/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=   # base pública do backend; vazio = deriva do pedido
