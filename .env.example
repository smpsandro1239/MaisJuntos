# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TURSO Database: LibSQL connection URL and Auth Token.
# Configure your Turso credentials (e.g. from https://app.turso.tech/smpsandro1239).
# If not provided, the server automatically uses local persistent SQLite with fallback.
TURSO_DATABASE_URL="libsql://your-db-smpsandro1239.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Backend/Worker e frontend (migração Cloudflare) ---
# Segredo de sessão do backend (gerar: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""

# Origens autorizadas (CORS e proteção CSRF), separadas por vírgula, sem espaços.
ALLOWED_ORIGINS="http://localhost:3000,https://maisjuntos-five.vercel.app"

# Frontend: Vazio = pedidos relativos /api/* (Vercel faz rewrite para o Worker).
# Definir apenas se o frontend for chamar o Worker diretamente (cross-origin).
VITE_API_URL=""

# Frontend: URL do WebSocket. O Vercel não faz proxy de WS, por isso aponta
# diretamente ao Worker. Sem esta variável usa o próprio domínio do frontend.
VITE_WS_URL="wss://juntos-backend.smpsandro1239.workers.dev"

# Credenciais das contas de sistema — usadas apenas no seed inicial
# (tabela `users` vazia). NUNCA versionar valores reais.
# O seed usa valores de desenvolvimento se estas variáveis não existirem.
ADMIN_PASSWORD=""
CURATOR_PASSWORD=""
PARENT_PASSWORD=""
